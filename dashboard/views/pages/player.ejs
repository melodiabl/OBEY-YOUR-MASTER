<script>
const GID = '<%= guild.id %>'
let st = null, elapsed = 0, progTimer = null, dirty = false, playerLoadBusy = false
// Tick suave con requestAnimationFrame
let _rafId = null, _syncAt = 0, _syncElapsed = 0, _syncLength = 0, _playing = false, _rafUri = null
function _startRaf(e, len) {
  _syncAt = performance.now(); _syncElapsed = e; _syncLength = len; _playing = true
  cancelAnimationFrame(_rafId)
  function _tick() {
    if (!_playing) return
    const e = Math.min(_syncLength, _syncElapsed + (performance.now() - _syncAt))
    document.getElementById('mp-prog-fill').style.width = (_syncLength > 0 ? (e / _syncLength * 100) : 0) + '%'
    document.getElementById('mp-cur').textContent = fmt(e)
    _rafId = requestAnimationFrame(_tick)
  }
  _rafId = requestAnimationFrame(_tick)
}
function _stopRaf() { _playing = false; cancelAnimationFrame(_rafId); _rafUri = null }

const fmt = ms => { const s=Math.floor((ms||0)/1000),m=Math.floor(s/60),sc=s%60; return `${m}:${String(sc).padStart(2,'0')}` }
const esc = s => String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))
function plat(uri='') {
  if(/spotify/i.test(uri))    return {cls:'plat-sp',label:'SP'}
  if(/soundcloud/i.test(uri)) return {cls:'plat-sc',label:'SC'}
  return                             {cls:'plat-yt',label:'YT'}
}
function sourceLabel(value='') {
  const key = String(value || '').toLowerCase()
  return ({
    spotify: 'Spotify',
    youtube: 'YouTube',
    ytmusic: 'YouTube Music',
    applemusic: 'Apple Music',
    soundcloud: 'SoundCloud',
    deezer: 'Deezer',
    tidal: 'Tidal',
    qobuz: 'Qobuz',
    jiosaavn: 'JioSaavn',
    yandex: 'Yandex',
  })[key] || (value ? String(value) : 'Música')
}
function yearFrom(value='') {
  const match = String(value || '').match(/\d{4}/)
  return match ? match[0] : ''
}
function metaParts(item={}, opts={}) {
  const parts = []
  if (opts.type && item.type === 'album') parts.push('Álbum')
  if (opts.type && item.type === 'playlist') parts.push('Playlist')
  if (item.albumName) parts.push(item.albumName)
  const year = yearFrom(item.releaseDate)
  if (year) parts.push(year)
  if (item.totalTracks) parts.push(`${item.totalTracks} pistas`)
  if (item.isStream) parts.push('Live')
  if (item.isrc && opts.isrc) parts.push(`ISRC ${item.isrc}`)
  if (item.requester && opts.requester) parts.push(`Pedido por ${item.requester}`)
  return parts.filter(Boolean)
}
function metaText(item={}, opts={}) {
  return metaParts(item, opts).slice(0, opts.limit || 3).join(' · ')
}
function metaChips(item={}, opts={}) {
  return metaParts(item, opts).slice(0, opts.limit || 3).map((part, index) =>
    `<span class="meta-chip ${index === 0 ? 'good' : ''}">${esc(part)}</span>`
  ).join('')
}
function toast(msg, type='ok') {
  const el = document.createElement('div'); el.className = `pt ${type}`
  el.innerHTML = `<i class="fas ${type==='ok'?'fa-circle-check':type==='info'?'fa-circle-info':'fa-circle-xmark'}"></i>${esc(msg)}`
  document.getElementById('toast-wrap').appendChild(el)
  setTimeout(() => el.remove(), 2600)
}

// ── Genres ────────────────────────────────────────────────────────
const GENRES = [
  {id:'reggaeton',e:'🎵',label:'Reggaeton', tag:'Latin Urban',q:'top reggaeton 2026',         g:'linear-gradient(135deg,#ec4899,#a855f7)'},
  {id:'pop',      e:'💫',label:'Pop',        tag:'Top 40',     q:'pop hits 2026 top songs',    g:'linear-gradient(135deg,#3b82f6,#6366f1)'},
  {id:'trap',     e:'🔥',label:'Trap Latino',tag:'Urbano',     q:'trap latino hits 2026',      g:'linear-gradient(135deg,#ef4444,#f97316)'},
  {id:'rock',     e:'🎸',label:'Rock',       tag:'Clásicos',   q:'rock clasicos exitos mix',   g:'linear-gradient(135deg,#eab308,#f97316)'},
  {id:'edm',      e:'⚡',label:'EDM',        tag:'Electronic', q:'electronic dance music 2026',g:'linear-gradient(135deg,#22d47d,#3b82f6)'},
  {id:'latin',    e:'🌴',label:'Latin Hits', tag:'Top Latino', q:'latin hits 2026 top',        g:'linear-gradient(135deg,#f59e0b,#ec4899)'},
  {id:'salsa',    e:'💃',label:'Salsa',      tag:'Tropical',   q:'salsa romantica top songs',  g:'linear-gradient(135deg,#a855f7,#ec4899)'},
  {id:'kpop',     e:'🎤',label:'K-Pop',      tag:'Hallyu',     q:'kpop hits 2026 best',        g:'linear-gradient(135deg,#06b6d4,#a855f7)'},
  {id:'anime',    e:'🎌',label:'Anime',      tag:'OST',        q:'anime opening songs best',   g:'linear-gradient(135deg,#6366f1,#ec4899)'},
  {id:'bachata',  e:'🌹',label:'Bachata',    tag:'Romántica',  q:'bachata romantica mix',      g:'linear-gradient(135deg,#dc2626,#9333ea)'},
  {id:'lofi',     e:'☕',label:'Lo-Fi',      tag:'Chill',      q:'lofi hip hop chill beats',   g:'linear-gradient(135deg,#475569,#3b82f6)'},
  {id:'rbd',      e:'🎭',label:'RBD',        tag:'Pop Rock',   q:'RBD mejores canciones mix',  g:'linear-gradient(135deg,#22d47d,#6366f1)'},
]
function buildGenreGrid() {
  document.getElementById('genre-grid').innerHTML = GENRES.map(g => `
    <div class="gc" data-id="${g.id}" onclick="loadGenre('${g.id}')">
      <div class="gc-bg" style="background:${g.g}"></div>
