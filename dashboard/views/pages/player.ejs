<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= guild.name %> — Player · OBEY YOUR MASTER</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="/socket.io/socket.io.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#06060f;--surf:#0d0d1a;--surf2:#12121f;--surf3:#181827;
  --border:rgba(255,255,255,.07);
  --p:#7c6df0;--p2:#a78bfa;--pink:#ec4899;--green:#1ed760;
  --red:#f04747;--yellow:#fcd34d;
  --text:#e8e8f4;--muted:#6b6b8e;
  --glow:rgba(124,109,240,.3);
}
html,body{height:100%;overflow:hidden;font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--text)}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.14)}

/* ── App shell ──────────────────────────────────────────────────── */
.app{display:flex;flex-direction:column;height:100vh;overflow:hidden}
.app-bg{
  position:fixed;inset:0;z-index:0;
  background-size:cover;background-position:center;
  filter:blur(100px) brightness(.08) saturate(3);
  transform:scale(1.3);transition:background-image 1.5s ease;pointer-events:none;
}
.app-content{position:relative;display:flex;flex-direction:column;height:100vh}

/* ── Top bar ────────────────────────────────────────────────────── */
.topbar{
  height:54px;background:rgba(6,6,15,.92);
  backdrop-filter:blur(24px);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 20px;gap:14px;flex-shrink:0;
}
.tb-logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:13px;letter-spacing:.05em;color:#fff}
.tb-logo-ico{
  width:30px;height:30px;
  background:linear-gradient(135deg,var(--p),var(--pink));
  border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;
  box-shadow:0 4px 14px var(--glow);
}
.tb-sep{width:1px;height:20px;background:var(--border)}
.tb-guild{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600}
.tb-guild img{width:24px;height:24px;border-radius:6px;object-fit:cover}
.tb-status{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.03em}
.tb-status.playing{background:rgba(30,215,96,.12);color:var(--green);border:1px solid rgba(30,215,96,.25)}
.tb-status.paused{background:rgba(252,211,77,.1);color:var(--yellow);border:1px solid rgba(252,211,77,.2)}
.tb-status.idle{background:rgba(107,107,142,.1);color:var(--muted);border:1px solid rgba(107,107,142,.15)}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.tb-btn{
  display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;
  padding:6px 12px;border-radius:8px;border:1px solid var(--border);
  background:var(--surf2);color:var(--muted);transition:all .15s;
}
.tb-btn:hover{border-color:var(--p);color:var(--p2)}
.tb-srch-toggle{
  display:none;align-items:center;gap:6px;
  font-size:12px;font-weight:600;padding:6px 12px;
  border-radius:8px;border:1px solid var(--border);
  background:var(--surf2);color:var(--muted);transition:all .15s;
}
.tb-srch-toggle:hover,.tb-srch-toggle.active{border-color:var(--p);color:var(--p2)}
.kh{font-size:10px;color:var(--muted);background:var(--surf3);border-radius:4px;padding:1px 5px;border:1px solid var(--border)}

/* ── Three-column main ──────────────────────────────────────────── */
.main{flex:1;display:grid;grid-template-columns:280px 1fr 340px;overflow:hidden;min-height:0}
.col{display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--border)}
.col:last-child{border:none}
.col-hd{
  padding:14px 16px 10px;border-bottom:1px solid var(--border);
  flex-shrink:0;display:flex;align-items:center;justify-content:space-between;
}
.col-hd-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);display:flex;align-items:center;gap:7px}

/* ── LEFT: Queue ─────────────────────────────────────────────────── */
.col-queue{background:rgba(6,6,15,.6)}
.q-acts{display:flex;gap:3px}
.q-act-btn{background:none;border:none;color:var(--muted);font-size:12px;padding:5px 8px;border-radius:6px;transition:all .12s}
.q-act-btn:hover{background:var(--surf2);color:var(--text)}
.q-act-btn.danger:hover{color:var(--red)}

/* Spotify queue rows */
.qi-list{flex:1;overflow-y:auto;padding:8px 0}
.qi{
  display:grid;grid-template-columns:28px 40px 1fr auto auto;
  align-items:center;gap:9px;
  padding:5px 14px;border-radius:4px;margin:0 4px;
  transition:background .1s;user-select:none;
}
.qi:hover{background:rgba(255,255,255,.07)}
.qi.active{background:rgba(30,215,96,.07)}
.qi-nwrap{width:16px;height:16px;display:flex;align-items:center;justify-content:center;position:relative}
.qi-num{font-size:13px;font-family:'JetBrains Mono',monospace;color:var(--muted)}
.qi-play-ico{display:none;color:#fff;font-size:13px}
.qi:hover:not(.active) .qi-num{display:none}
.qi:hover:not(.active) .qi-play-ico{display:flex}
.qi-eq{display:none;align-items:flex-end;gap:2px;height:14px}
.qi.active .qi-num{display:none}
.qi.active .qi-play-ico{display:none}
.qi.active .qi-eq{display:flex}
.eq-bar{width:3px;border-radius:2px;background:var(--green);animation:eq .8s ease-in-out infinite}
.eq-bar:nth-child(1){height:8px;animation-delay:0s}
.eq-bar:nth-child(2){height:14px;animation-delay:.15s}
.eq-bar:nth-child(3){height:6px;animation-delay:.3s}
.qi.active.paused .eq-bar{animation-play-state:paused}
@keyframes eq{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
.qi-thumb{width:40px;height:40px;border-radius:4px;object-fit:cover;background:var(--surf3);flex-shrink:0}
.qi-info{min-width:0}
.qi-title{font-size:13px;font-weight:400;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qi.active .qi-title{color:var(--green)}
.qi-author{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.qi-dur{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--muted)}
.qi-btns{display:flex;gap:1px;opacity:0;transition:opacity .12s}
.qi:hover .qi-btns{opacity:1}
.qi-btn{width:24px;height:24px;background:none;border:none;color:var(--muted);font-size:11px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .12s}
.qi-btn:hover{color:#fff}
.qi-btn.del:hover{color:var(--red)}

/* ── CENTER: Home content ────────────────────────────────────────── */
.col-center{background:transparent;border:none}
.home-scroll{flex:1;overflow-y:auto;padding-bottom:8px}

/* ── CENTER: discover sections ──────────────────────────────────── */
.home-scroll{flex:1;overflow-y:auto;padding-bottom:8px}
.section-hd{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 6px}
.section-hd span{font-size:15px;font-weight:700;color:#fff}
.h-row{display:flex;gap:12px;padding:4px 20px 16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.h-row::-webkit-scrollbar{display:none}
.hcard{flex-shrink:0;width:136px;cursor:pointer;border-radius:8px;padding:10px 10px 8px;background:rgba(255,255,255,.03);transition:background .15s;scroll-snap-align:start}
.hcard:hover{background:rgba(255,255,255,.09)}
.hcard-art-wrap{position:relative;margin-bottom:8px}
.hcard-art{width:116px;height:116px;border-radius:6px;object-fit:cover;display:block;background:var(--surf3);box-shadow:0 4px 16px rgba(0,0,0,.5)}
.hcard-art-ph{width:116px;height:116px;border-radius:6px;background:var(--surf3);display:flex;align-items:center;justify-content:center;font-size:32px}
.hcard-play{position:absolute;bottom:5px;right:5px;width:34px;height:34px;border-radius:50%;background:var(--green);color:#000;border:none;font-size:12px;display:flex;align-items:center;justify-content:center;opacity:0;transform:translateY(6px);transition:all .2s;box-shadow:0 4px 12px rgba(0,0,0,.5)}
.hcard:hover .hcard-play{opacity:1;transform:translateY(0)}
.hcard-title{font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.hcard-artist{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hcard-plays{font-size:10px;color:var(--green);margin-top:2px}
.hcard-type-label{font-size:10px;color:var(--muted);margin-top:4px;opacity:.8}
.hcard-collection .hcard-art{border-radius:4px}
.hcard-collection .hcard-art-ph{border-radius:4px}
.hcard-kind{display:inline-flex;align-items:center;gap:4px;margin-top:6px;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.07);color:var(--muted);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.hcard-kind.spotify{color:#5ee98d;background:rgba(30,215,96,.1)}
.hcard-kind.youtube,.hcard-kind.ytmusic{color:#ff7c7c;background:rgba(255,0,0,.1)}
.hcard-kind.soundcloud{color:#ff9b63;background:rgba(255,85,0,.1)}
.hcard-kind.deezer{color:#b692ff;background:rgba(167,139,250,.12)}
.meta-chips{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-top:6px;min-height:18px}
.meta-chip{display:inline-flex;align-items:center;gap:4px;max-width:100%;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.05);color:var(--muted);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
.meta-chip.good{color:#5ee98d;background:rgba(30,215,96,.09);border-color:rgba(30,215,96,.12)}
.meta-chip.warn{color:#fcd34d;background:rgba(252,211,77,.09);border-color:rgba(252,211,77,.12)}
.meta-inline{display:flex;align-items:center;gap:6px;min-width:0;flex-wrap:wrap;margin-top:4px;color:var(--muted);font-size:10px}
.meta-inline span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}

.discover-hero{position:relative;overflow:hidden;margin:18px 20px 8px;min-height:190px;padding:26px;border-radius:8px;background:rgba(13,13,26,.84);border:1px solid rgba(255,255,255,.09);box-shadow:0 18px 50px rgba(0,0,0,.25)}
.discover-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(100deg,rgba(124,109,240,.14),transparent 55%,rgba(30,215,96,.08));pointer-events:none}
.discover-copy{position:relative;z-index:1;max-width:680px}
.discover-kicker{font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--green);margin-bottom:9px}
.discover-title{font-size:32px;line-height:1.08;font-weight:800;letter-spacing:0;color:#fff;max-width:620px}
.discover-sub{font-size:13px;line-height:1.55;color:var(--muted);max-width:600px;margin-top:9px}
.discover-actions{display:flex;align-items:center;gap:9px;margin-top:20px;flex-wrap:wrap}
.discover-primary,.discover-secondary{border:none;border-radius:999px;padding:9px 16px;font-size:12px;font-weight:800;display:inline-flex;align-items:center;gap:7px;transition:transform .15s,filter .15s}
.discover-primary{background:#fff;color:#160c2b}.discover-primary:hover{transform:scale(1.03);filter:brightness(.95)}
.discover-secondary{background:rgba(0,0,0,.24);color:#fff;border:1px solid rgba(255,255,255,.18)}
.discover-secondary:hover{background:rgba(0,0,0,.36)}
.server-pulse{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px}
.pulse-item{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;background:rgba(255,255,255,.045);border:1px solid var(--border);color:var(--muted);font-size:10px;font-weight:700}
.pulse-item i{color:var(--p2)}
.section-copy{display:flex;flex-direction:column;gap:2px}.section-copy small{font-size:10px;font-weight:500;color:var(--muted)}
.quick-mixes{display:flex;gap:8px;padding:4px 20px 8px;overflow-x:auto;scrollbar-width:none}
.quick-mixes::-webkit-scrollbar{display:none}
.quick-mix{display:inline-flex;align-items:center;gap:7px;flex-shrink:0;padding:8px 11px;border:1px solid var(--border);border-radius:8px;background:rgba(255,255,255,.035);color:var(--muted);font-size:11px;font-weight:700;transition:all .15s}
.quick-mix i{color:var(--p2)}
.quick-mix:hover{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.16);color:#fff;transform:translateY(-1px)}

/* Next mini pills (in now-bar) */
.ct-mini-pill{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:2px 0}
.ct-mini-pill span{color:var(--text);font-weight:500}


/* Album cards (search results) */
.alb-row{
  display:flex;gap:14px;padding:4px 10px 12px;
  overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;
}
.alb-row::-webkit-scrollbar{display:none}
.alb-card{
  flex-shrink:0;width:136px;cursor:pointer;
  border-radius:8px;padding:10px 10px 8px;
  background:rgba(255,255,255,.03);
  transition:background .15s;scroll-snap-align:start;
}
.alb-card:hover{background:rgba(255,255,255,.09)}
.alb-art-wrap{position:relative;margin-bottom:8px}
.alb-art{width:116px;height:116px;border-radius:6px;object-fit:cover;display:block;background:var(--surf3);box-shadow:0 4px 16px rgba(0,0,0,.5)}
.alb-art-ph{width:116px;height:116px;border-radius:6px;background:var(--surf3);display:flex;align-items:center;justify-content:center;font-size:32px}
.alb-play{
  position:absolute;bottom:5px;right:5px;width:34px;height:34px;
  border-radius:50%;background:var(--green);color:#000;border:none;
  font-size:12px;display:flex;align-items:center;justify-content:center;
  opacity:0;transform:translateY(6px);transition:all .2s;box-shadow:0 4px 12px rgba(0,0,0,.5);
}
.alb-card:hover .alb-play{opacity:1;transform:translateY(0)}
.alb-title{font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.alb-artist{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* Skeleton */
.hcard-skel{flex-shrink:0;width:136px;padding:10px;animation:sk .8s ease-in-out infinite alternate}
.hcard-skel-art{width:116px;height:116px;border-radius:6px;background:var(--surf3);margin-bottom:8px}
.hcard-skel-line{height:11px;border-radius:6px;background:var(--surf3);margin-bottom:6px}
@keyframes sk{from{opacity:.3}to{opacity:.65}}

/* ── RIGHT: Search + Browse ──────────────────────────────────────── */
.col-right{background:rgba(6,6,15,.7);display:flex;flex-direction:column}
.s-bar{display:flex;padding:10px 12px 8px;gap:0;flex-shrink:0}
.s-inp{
  flex:1;background:var(--surf2);border:1px solid var(--border);
  border-right:none;color:var(--text);padding:9px 13px;
  border-radius:9px 0 0 9px;font-size:13px;outline:none;font-family:inherit;transition:border-color .15s;
}
.s-inp:focus{border-color:var(--p)}
.s-btn{
  background:linear-gradient(135deg,var(--p),var(--pink));
  color:#fff;border:none;padding:9px 16px;
  border-radius:0 9px 9px 0;font-size:13px;transition:opacity .15s;
}
.s-btn:hover{opacity:.85}
.source-strip{display:flex;gap:6px;padding:0 12px 10px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--border);flex-shrink:0}
.source-strip::-webkit-scrollbar{display:none}
.source-chip{flex-shrink:0;border:1px solid var(--border);background:var(--surf2);color:var(--muted);border-radius:999px;padding:5px 9px;font-size:10px;font-weight:700;white-space:nowrap;transition:all .15s}
.source-chip:hover{color:#fff;border-color:rgba(255,255,255,.2)}
.source-chip.active{background:#fff;color:#0b0b14;border-color:#fff}

/* Browse panel */
.browse-hd{padding:14px 16px 6px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.genre-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:4px 14px 14px}
.gc{position:relative;height:60px;border-radius:8px;overflow:hidden;cursor:pointer;transition:opacity .15s;border:1px solid rgba(255,255,255,.06)}
.gc:hover{opacity:.82}
.gc-bg{position:absolute;inset:0;opacity:.9}
.gc-ico{position:absolute;right:-4px;bottom:-6px;font-size:40px;opacity:.3;line-height:1}
.gc-label{position:relative;padding:10px 12px;font-size:13px;font-weight:700;color:#fff;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.gc-tag{display:block;font-size:10px;font-weight:500;color:rgba(255,255,255,.6);margin-top:1px}
.gc.active-genre{outline:2px solid rgba(255,255,255,.4)}

/* Results panel */
.r-hd{display:flex;align-items:center;justify-content:space-between;padding:8px 16px 6px;flex-shrink:0;border-bottom:1px solid var(--border)}
.r-hd-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);display:flex;align-items:center;gap:6px}
.r-back{background:none;border:none;color:var(--muted);font-size:11px;padding:3px 8px;border-radius:5px;transition:all .12s}
.r-back:hover{background:var(--surf2);color:var(--text)}
.r-tabs{display:flex;gap:5px;padding:8px 12px;border-bottom:1px solid var(--border);flex-shrink:0;overflow-x:auto;scrollbar-width:none}
.r-tab{border:none;border-radius:999px;background:var(--surf2);color:var(--muted);font-size:10px;font-weight:700;padding:6px 10px;white-space:nowrap}
.r-tab.active{background:#fff;color:#0a0a12}
.r-empty{padding:34px 20px;text-align:center;color:var(--muted);font-size:12px;line-height:1.5}
.r-empty i{display:block;font-size:24px;margin-bottom:10px;opacity:.32}

/* Idle (in right panel) */
.np-idle-right{display:flex;flex-direction:column;align-items:center;padding:28px 20px 20px;text-align:center;border-bottom:1px solid var(--border)}
.np-idle-right-art{width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,var(--surf3),var(--surf2));display:flex;align-items:center;justify-content:center;font-size:36px;opacity:.22;margin-bottom:10px;animation:idle-pulse 3.5s ease-in-out infinite}
@keyframes idle-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
.np-idle-right-title{font-size:14px;font-weight:700;color:var(--text);opacity:.35;margin-bottom:3px}
.np-idle-right-sub{font-size:12px;color:var(--muted);opacity:.38}

/* Spotify search result rows */
.sp-list{padding:8px 0}
.sp-tr{
  display:grid;grid-template-columns:28px 40px 1fr auto auto;
  align-items:center;gap:11px;padding:5px 14px;border-radius:4px;
  transition:background .1s;user-select:none;cursor:default;margin:0 4px;
}
.sp-tr:hover{background:rgba(255,255,255,.07)}
.sp-nwrap{width:16px;height:16px;display:flex;align-items:center;justify-content:center}
.sp-num{font-size:13px;font-family:'JetBrains Mono',monospace;color:var(--muted)}
.sp-play-ico{display:none;color:#fff;font-size:13px}
.sp-tr:hover .sp-num{display:none}
.sp-tr:hover .sp-play-ico{display:flex}
.sp-thumb{width:40px;height:40px;border-radius:4px;object-fit:cover;background:var(--surf3);flex-shrink:0}
.sp-info{min-width:0}
.sp-title{font-size:13px;font-weight:400;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}
.sp-artist{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.sp-dur{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--muted);flex-shrink:0}
.sp-add{width:26px;height:26px;background:none;border:none;color:var(--muted);font-size:15px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .12s;opacity:0}
.sp-tr:hover .sp-add{opacity:1}
.sp-add:hover{color:var(--green);transform:scale(1.15)}
.sp-add.added{color:var(--green);opacity:1}

/* Top result card */
.top-result-card{margin:10px 10px 0;padding:16px;border-radius:10px;background:rgba(255,255,255,.06);transition:background .15s}
.top-result-card:hover{background:rgba(255,255,255,.09)}
.top-result-art{width:80px;height:80px;border-radius:8px;object-fit:cover;background:var(--surf3);margin-bottom:12px;display:block;box-shadow:0 8px 24px rgba(0,0,0,.5)}
.top-result-art.ph{display:flex;align-items:center;justify-content:center;font-size:32px}
.top-result-title{font-size:18px;font-weight:700;color:#fff;margin-bottom:5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.top-result-sub{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.top-result-badge{font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;background:rgba(255,255,255,.1);padding:3px 10px;border-radius:20px;color:var(--text)}
.btn-add-green{background:var(--green);color:#000;border:none;border-radius:20px;padding:7px 18px;font-size:13px;font-weight:700;font-family:inherit;transition:transform .15s,filter .15s;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.btn-add-green:hover{filter:brightness(1.1);transform:scale(1.04)}

/* ── MINI PLAYER (bottom bar) ────────────────────────────────────── */
.mini-player{
  height:76px;
  background:rgba(9,9,18,.97);
  backdrop-filter:blur(30px);
  border-top:1px solid var(--border);
  display:none; /* shown via JS when active */
  align-items:center;
  padding:0 20px;
  gap:0;
  flex-shrink:0;
  z-index:20;
}
.mini-player.show{display:flex}

/* Left: art + info */
.mp-left{display:flex;align-items:center;gap:12px;width:260px;flex-shrink:0}
.mp-art{width:52px;height:52px;border-radius:6px;object-fit:cover;display:block;background:var(--surf3);flex-shrink:0;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.mp-art-ph{width:52px;height:52px;border-radius:6px;background:var(--surf3);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.mp-info{min-width:0;flex:1}
.mp-title{font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mp-artist{font-size:11px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mp-like{background:none;border:none;color:var(--muted);font-size:15px;padding:6px;border-radius:50%;transition:all .15s;flex-shrink:0}
.mp-like:hover,.mp-like.on{color:#f87171}

/* Center: controls + progress */
.mp-center{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;padding:0 24px}
.mp-controls{display:flex;align-items:center;gap:4px}
.mc-btn{background:none;border:none;color:var(--muted);font-size:16px;padding:7px;border-radius:50%;transition:all .15s;width:36px;height:36px;display:flex;align-items:center;justify-content:center}
.mc-btn:hover{color:#fff}
.mc-btn.lit{color:var(--green)}
.mc-btn-play{
  width:34px;height:34px;border-radius:50%;
  background:#fff;color:#000;border:none;
  font-size:14px;display:flex;align-items:center;justify-content:center;
  transition:transform .15s;
}
.mc-btn-play:hover{transform:scale(1.07)}
/* Progress bar */
.mp-prog{display:flex;align-items:center;gap:8px;width:100%}
.mp-time{font-size:10px;font-family:'JetBrains Mono',monospace;color:var(--muted);flex-shrink:0}
.mp-prog-track{
  flex:1;height:4px;background:rgba(255,255,255,.12);
  border-radius:2px;cursor:pointer;position:relative;transition:height .15s;
}
.mp-prog-track:hover{height:6px}
.mp-prog-fill{
  height:100%;border-radius:inherit;background:var(--green);
  width:0%;pointer-events:none;position:relative;
}
.mp-prog-track:hover .mp-prog-fill{background:linear-gradient(90deg,var(--p2),var(--pink))}
.mp-prog-fill::after{
  content:'';position:absolute;right:-6px;top:50%;transform:translateY(-50%);
  width:12px;height:12px;border-radius:50%;background:#fff;
  opacity:0;transition:opacity .15s;pointer-events:none;
}
.mp-prog-track:hover .mp-prog-fill::after{opacity:1}

/* Right: volume + extra */
.mp-right{display:flex;align-items:center;gap:8px;width:200px;justify-content:flex-end;flex-shrink:0}
.mp-vol-ico{font-size:14px;color:var(--muted);flex-shrink:0}
input[type=range].mp-vslider{
  width:90px;height:4px;-webkit-appearance:none;appearance:none;
  background:rgba(255,255,255,.15);border-radius:2px;outline:none;cursor:pointer;
}
input[type=range].mp-vslider::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;border-radius:50%;background:#fff;cursor:pointer}
input[type=range].mp-vslider:hover{background:rgba(255,255,255,.25)}
.mp-stop{background:none;border:none;color:var(--muted);font-size:14px;padding:5px;border-radius:50%;transition:all .15s}
.mp-stop:hover{color:var(--red)}
.mp-queue-toggle{background:none;border:none;color:var(--muted);font-size:14px;padding:5px;border-radius:50%;transition:all .15s}
.mp-queue-toggle:hover,.mp-queue-toggle.lit{color:#fff}

/* ── Backdrop (drawer overlay) ──────────────────────────────────── */
.drawer-backdrop{display:none;position:fixed;inset:0;z-index:79;background:rgba(0,0,0,.5)}
.drawer-backdrop.show{display:block}

/* ── Toasts ─────────────────────────────────────────────────────── */
#toast-wrap{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:7px;z-index:999}
.pt{background:rgba(13,13,26,.96);backdrop-filter:blur(16px);border:1px solid var(--border);border-radius:10px;padding:10px 16px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px;animation:ptIn .2s ease;max-width:320px}
@keyframes ptIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.pt.ok{border-color:rgba(30,215,96,.3);color:var(--green)}
.pt.err{border-color:rgba(240,71,71,.3);color:var(--red)}
.pt.info{border-color:rgba(124,109,240,.3);color:var(--p2)}

/* ── Mobile nav ─────────────────────────────────────────────────── */
.mobile-nav{display:none;height:56px;flex-shrink:0;background:rgba(6,6,15,.97);backdrop-filter:blur(20px);border-top:1px solid var(--border);z-index:50}
.mn-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:none;border:none;color:var(--muted);font-size:10px;font-weight:600;font-family:inherit;padding:6px 0;transition:color .15s;cursor:pointer}
.mn-btn i{font-size:19px;margin-bottom:1px}
.mn-btn.active{color:#fff}
.mn-btn.active i{color:var(--green)}

/* ── KB modal ────────────────────────────────────────────────────── */
#kb-modal{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(10px);z-index:200;display:none;align-items:center;justify-content:center}
#kb-modal.show{display:flex}
.kb-box{background:var(--surf);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:24px 28px;max-width:400px;width:90%;box-shadow:0 24px 80px rgba(0,0,0,.6)}
.kb-box h3{font-size:16px;font-weight:800;margin-bottom:18px;display:flex;align-items:center;gap:9px}
.kb-row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:13px}
.kb-row:last-of-type{border:none}
.kk{background:var(--surf3);border:1px solid rgba(255,255,255,.12);border-radius:5px;padding:3px 9px;font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--text)}
.kb-close{margin-top:18px;width:100%;padding:10px;border-radius:9px;background:var(--surf2);border:1px solid var(--border);color:var(--text);font-size:13px;font-weight:600;transition:all .15s}
.kb-close:hover{border-color:var(--p);color:var(--p2)}
.vc-item{display:flex;align-items:center;gap:4px;padding:11px 14px;border-radius:9px;background:var(--surf3);border:1px solid transparent;color:var(--text);font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;text-align:left}
.vc-item:hover{border-color:var(--p);background:rgba(139,92,246,.1);color:var(--p2)}
.vc-members{margin-left:auto;font-size:11px;color:var(--muted)}

/* ── Preview modal ──────────────────────────────────────────────── */
.preview-modal{display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;background:rgba(0,0,0,.7);backdrop-filter:blur(8px)}
.preview-modal.show{display:flex}
.preview-box{background:var(--surf);border:1px solid rgba(255,255,255,.08);border-radius:16px;width:480px;max-width:92vw;max-height:80vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.6)}
.preview-hd{display:flex;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid var(--border);flex-shrink:0}
.preview-hd-art{width:44px;height:44px;border-radius:8px;object-fit:cover;background:var(--surf3);flex-shrink:0}
.preview-hd-info{min-width:0;flex:1}
.preview-hd-title{font-size:14px;font-weight:700;color:#fff;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.preview-hd-sub{font-size:11px;color:var(--muted);margin-top:2px}
.preview-hd-close{background:none;border:none;color:var(--muted);font-size:20px;padding:4px;cursor:pointer;border-radius:6px;transition:all .12s;flex-shrink:0;line-height:1}
.preview-hd-close:hover{color:#fff;background:var(--surf3)}
.preview-actions{display:flex;gap:8px;padding:10px 18px;border-bottom:1px solid var(--border);flex-shrink:0}
.preview-add-all{background:var(--green);color:#000;border:none;border-radius:8px;padding:7px 16px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:6px}
.preview-add-all:hover{filter:brightness(1.1);transform:scale(1.03)}
.preview-list{flex:1;overflow-y:auto;padding:6px 0}
.pr-tr{display:grid;grid-template-columns:28px 36px 1fr auto;align-items:center;gap:10px;padding:6px 14px;border-radius:4px;margin:0 4px;transition:background .1s;cursor:default}
.pr-tr:hover{background:rgba(255,255,255,.07)}
.pr-nwrap{width:16px;display:flex;align-items:center;justify-content:center}
.pr-num{font-size:12px;font-family:'JetBrains Mono',monospace;color:var(--muted)}
.pr-thumb{width:36px;height:36px;border-radius:4px;object-fit:cover;background:var(--surf3);flex-shrink:0}
.pr-info{min-width:0}
.pr-title{font-size:12px;font-weight:400;color:var(--text);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.pr-author{font-size:10px;color:var(--muted);margin-top:1px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.pr-meta{font-size:9px;color:var(--muted);opacity:.72;margin-top:1px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.pr-dur{font-size:10px;font-family:'JetBrains Mono',monospace;color:var(--muted);flex-shrink:0}
.pr-add{width:24px;height:24px;background:none;border:none;color:var(--muted);font-size:12px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .12s;opacity:0;cursor:pointer;flex-shrink:0}
.pr-tr:hover .pr-add{opacity:1}
.pr-add:hover{color:var(--green);transform:scale(1.15)}
.pr-add.added{color:var(--green);opacity:1}
.pr-empty{padding:32px 18px;text-align:center;color:var(--muted);font-size:12px}
.pr-empty i{display:block;font-size:22px;margin-bottom:8px;opacity:.3}

/* ── Responsive ─────────────────────────────────────────────────── */
@media(max-width:1280px){.main{grid-template-columns:260px 1fr 320px}}
@media(max-width:1060px){.main{grid-template-columns:240px 1fr 300px}.mp-left{width:220px}.mp-right{width:160px}}
@media(max-width:960px){
  .main{grid-template-columns:240px 1fr}
  .col-right{position:fixed;top:54px;right:0;bottom:0;width:320px;z-index:80;background:var(--surf);border-left:1px solid var(--border);transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1)}
  .col-right.open{transform:translateX(0);box-shadow:-12px 0 40px rgba(0,0,0,.5)}
  .tb-srch-toggle{display:flex !important}
  .mp-left{width:180px}
  .mp-right{display:none}
}
@media(max-width:700px){
  .main{grid-template-columns:1fr}
  .col-queue{position:fixed;top:54px;left:0;bottom:76px;width:82vw;max-width:300px;z-index:80;background:var(--bg);border-right:1px solid var(--border);transform:translateX(-100%);transition:transform .3s cubic-bezier(.4,0,.2,1)}
  .col-queue.open{transform:translateX(0);box-shadow:12px 0 40px rgba(0,0,0,.5)}
  .col-right{top:54px;bottom:76px;width:90vw;max-width:360px}
  .mobile-nav{display:flex !important}
  .mp-center{padding:0 8px}
  .mp-left{width:140px}
  #toast-wrap{bottom:140px}
  .discover-hero{margin:12px 12px 6px;padding:22px;min-height:190px}.discover-title{font-size:31px}.section-hd{padding-left:14px;padding-right:14px}.h-row{padding-left:14px;padding-right:14px}
}
@media(max-width:480px){
  .mp-left{width:120px}.mp-artist{display:none}
  .alb-card{width:116px}.alb-art,.alb-art-ph{width:98px;height:98px}
}
</style>
</head>
<body>
<div class="app">
  <div class="app-bg" id="app-bg"></div>
  <div class="app-content">

    <!-- ── Top bar ─────────────────────────────────────────────── -->
    <div class="topbar">
      <a href="/" class="tb-logo">
        <div class="tb-logo-ico"><i class="fas fa-robot"></i></div>
        OBEY
      </a>
      <div class="tb-sep"></div>
      <% if (guild.icon) { %>
        <div class="tb-guild"><img src="<%= guild.icon %>" alt=""><span class="tb-guild-name"><%= guild.name %></span></div>
      <% } else { %>
        <div class="tb-guild"><i class="fab fa-discord" style="color:#5865F2"></i><span class="tb-guild-name"> <%= guild.name %></span></div>
      <% } %>
      <span class="tb-status idle" id="top-status">Sin música</span>
      <div class="tb-right">
        <button class="tb-srch-toggle" id="tb-srch-toggle" onclick="toggleRightPanel()">
          <i class="fas fa-search"></i> Buscar
        </button>
        <a href="/dashboard/<%= guild.id %>" class="tb-btn"><i class="fas fa-cog"></i> Config</a>
        <button class="tb-btn" onclick="document.getElementById('kb-modal').classList.add('show')">
          <i class="fas fa-keyboard"></i><span class="kh">?</span>
        </button>
      </div>
    </div>

    <!-- ── Main columns ───────────────────────────────────────── -->
    <div class="main">

      <!-- ════ LEFT: Queue ════════════════════════════════════ -->
      <div class="col col-queue">
        <div class="col-hd">
          <span class="col-hd-title">
            <i class="fas fa-list-ul" style="color:var(--green)"></i>
            Cola <span id="q-count" style="font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0"></span>
          </span>
          <div class="q-acts">
            <button class="q-act-btn" onclick="ctrl('shuffle')" title="Mezclar"><i class="fas fa-shuffle"></i></button>
            <button class="q-act-btn danger" onclick="clearQueue()" title="Limpiar"><i class="fas fa-trash-can"></i></button>
          </div>
        </div>
        <div class="qi-list" id="q-list">
          <div style="padding:32px 16px;text-align:center;color:var(--muted);opacity:.35;font-size:13px">
            <i class="fas fa-music" style="display:block;font-size:22px;margin-bottom:10px;opacity:.3"></i>Cola vacía
          </div>
        </div>
      </div>

      <!-- ════ CENTER: Discover + Now playing ═══════════════ -->
      <div class="col col-center">
        <div class="home-scroll" id="home-scroll">

          <!-- Now playing bar (shown when active) -->
          <div id="ct-now-bar" style="display:none;align-items:center;gap:14px;padding:16px 20px 12px;border-bottom:1px solid var(--border);background:rgba(30,215,96,.05)">
            <div style="position:relative;flex-shrink:0">
              <img id="ct-art" style="width:56px;height:56px;border-radius:7px;object-fit:cover;display:block;box-shadow:0 4px 14px rgba(0,0,0,.5)" src="" alt="">
              <div id="ct-art-ph" style="width:56px;height:56px;border-radius:7px;background:var(--surf3);display:none;align-items:center;justify-content:center;font-size:22px">🎵</div>
            </div>
            <div style="min-width:0;flex:1">
              <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--green);margin-bottom:3px">▶ Reproduciendo</div>
              <div id="ct-title" style="font-size:14px;font-weight:700;color:#fff;overflow:hidden;white-space:nowrap;text-overflow:ellipsis"></div>
              <div id="ct-artist" style="font-size:12px;color:var(--muted);margin-top:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis"></div>
              <div id="ct-meta" class="meta-inline"></div>
            </div>
            <!-- Next up pills -->
            <div id="ct-next-mini" style="display:flex;flex-direction:column;gap:4px;min-width:0;max-width:160px"></div>
          </div>

          <section class="discover-hero">
            <div class="discover-copy">
              <div class="discover-kicker">Sala musical de Discord</div>
              <h1 class="discover-title"><%= guild.name %></h1>
              <p class="discover-sub" id="server-room-copy">Controla lo que suena en el canal de voz y descubre música basada en la actividad real de este servidor.</p>
              <div class="server-pulse">
                <span class="pulse-item"><i class="fas fa-wave-square"></i><span id="pulse-state">Sin reproducción</span></span>
                <span class="pulse-item"><i class="fas fa-list"></i><span id="pulse-queue">Cola vacía</span></span>
                <span class="pulse-item"><i class="fas fa-clock-rotate-left"></i><span id="pulse-history">Sin historial reciente</span></span>
              </div>
              <div class="discover-actions">
                <button class="discover-primary" onclick="playServerMix()"><i class="fas fa-wand-magic-sparkles"></i> Mix del servidor</button>
                <button class="discover-secondary" onclick="document.getElementById('s-inp').focus();toggleRightPanel()"><i class="fas fa-magnifying-glass"></i> Buscar música</button>
              </div>
            </div>
          </section>

          <div class="quick-mixes" aria-label="Mezclas rápidas">
            <button class="quick-mix" onclick="discoverSearch('música energética para entrenar')"><i class="fas fa-bolt"></i>Energía</button>
            <button class="quick-mix" onclick="discoverSearch('chill relax mix')"><i class="fas fa-mug-hot"></i>Relax</button>
            <button class="quick-mix" onclick="discoverSearch('urbano latino viral')"><i class="fas fa-fire"></i>Urbano</button>
            <button class="quick-mix" onclick="discoverSearch('party hits mix')"><i class="fas fa-champagne-glasses"></i>Fiesta</button>
            <button class="quick-mix" onclick="discoverSearch('focus music playlist')"><i class="fas fa-headphones"></i>Focus</button>
            <button class="quick-mix" onclick="discoverSearch('nuevos lanzamientos música')"><i class="fas fa-wand-magic-sparkles"></i>Novedades</button>
          </div>

          <!-- Más reproducidas (from DB) -->
          <div class="section-hd" id="top-hd" style="display:none">
            <div class="section-copy"><span>Tus favoritas</span><small>Lo más escuchado en este servidor</small></div>
          </div>
          <div class="h-row" id="section-top"></div>

          <!-- Discover sections -->
          <div class="section-hd">
            <div class="section-copy"><span>Radar musical</span><small>Una mezcla de lanzamientos, virales, urbano y pop sin resultados repetidos</small></div>
          </div>
          <div class="h-row" id="section-trending">
            <% for(let i=0;i<4;i++) { %><div class="hcard-skel"><div class="hcard-skel-art"></div><div class="hcard-skel-line" style="width:80%"></div><div class="hcard-skel-line" style="width:55%"></div></div><% } %>
          </div>

          <div class="section-hd">
            <div class="section-copy"><span>Descubre para tu servidor</span><small id="server-mix-copy">Preparando recomendaciones según lo que escuchan aquí</small></div>
          </div>
          <div class="h-row" id="section-pop">
            <% for(let i=0;i<4;i++) { %><div class="hcard-skel"><div class="hcard-skel-art"></div><div class="hcard-skel-line" style="width:75%"></div><div class="hcard-skel-line" style="width:50%"></div></div><% } %>
          </div>

          <div class="section-hd">
            <div class="section-copy"><span>Artistas populares</span><small>Canciones de los artistas más escuchados ahora</small></div>
          </div>
          <div class="h-row" id="section-rock">
            <% for(let i=0;i<4;i++) { %><div class="hcard-skel"><div class="hcard-skel-art"></div><div class="hcard-skel-line" style="width:70%"></div><div class="hcard-skel-line" style="width:45%"></div></div><% } %>
          </div>


        </div>
      </div>

      <!-- ════ RIGHT: Search + Browse ════════════════════════ -->
      <div class="col col-right">
        <div class="s-bar">
          <input type="text" class="s-inp" id="s-inp"
            placeholder="Canción, artista o enlace…"
            onkeydown="if(event.key==='Enter')doSearch()">
          <button class="s-btn" onclick="doSearch()"><i class="fas fa-search"></i></button>
        </div>
        <div class="source-strip" id="source-strip" style="display:none">
        </div>

        <!-- Browse panel -->
        <div id="pane-browse" style="flex:1;overflow-y:auto">
          <div id="np-idle" class="np-idle-right">
            <div class="np-idle-right-art">🎵</div>
            <div class="np-idle-right-title">Sin música</div>
            <div class="np-idle-right-sub">Busca algo o elige un género</div>
          </div>
          <div class="browse-hd">Explorar</div>
