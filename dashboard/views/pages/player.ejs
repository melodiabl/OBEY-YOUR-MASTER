// ── Right panel toggle ─────────────────────────────────────────────
function showBrowse() {
  document.getElementById('pane-browse').style.display  = 'block'
  document.getElementById('pane-results').style.display = 'none'
  document.querySelectorAll('.gc').forEach(c => c.classList.remove('active-genre'))
}
function showResults(label) {
  document.getElementById('pane-browse').style.display  = 'none'
  const rp = document.getElementById('pane-results')
  rp.style.display = 'flex'
  document.getElementById('r-label').innerHTML = `<i class="fas fa-music"></i> ${esc(label)}`
}

let activeSource = 'spotify'
let activeResultKind = 'all'
let lastCatalog = { tracks: [], albums: [], playlists: [] }
let serverSeedTracks = []
let serverMixItems = []

async function searchAPI(query, source = activeSource, kind = 'all') {
  return fetch(`/api/player/${GID}/search`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query, source, kind }),
  }).then(r => r.json())
}

function discoverSearch(query) {
  document.getElementById('s-inp').value = query
  if (window.innerWidth <= 960) toggleRightPanel()
  doSearch()
}

async function loadGenre(id) {
  const g = GENRES.find(x => x.id === id); if (!g) return
  document.querySelectorAll('.gc').forEach(c => c.classList.toggle('active-genre', c.dataset.id === id))
  showResults(g.label)
  document.getElementById('r-list').innerHTML =
    '<div style="padding:24px;text-align:center;font-size:13px;color:var(--muted)"><i class="fas fa-spinner fa-spin" style="margin-right:6px"></i>Cargando…</div>'
  try {
    const catalog = await searchAPI(g.q)
    activeResultKind = 'all'
    renderCatalog(document.getElementById('r-list'), catalog)
  } catch {
    document.getElementById('r-list').innerHTML = '<div style="padding:16px;text-align:center;font-size:12px;color:var(--red)">Error</div>'
  }
}

// ── Search ─────────────────────────────────────────────────────────
let searchBusy = false
async function doSearch() {
  const q = document.getElementById('s-inp').value.trim()
  if (!q || searchBusy) return
  searchBusy = true
  showResults(`"${q}"`)
  document.getElementById('r-list').innerHTML =
    '<div style="padding:24px;text-align:center;font-size:13px;color:var(--muted)"><i class="fas fa-spinner fa-spin" style="margin-right:6px"></i>Buscando…</div>'
  try {
    const catalog = await searchAPI(q)
    activeResultKind = 'all'
    renderCatalog(document.getElementById('r-list'), catalog)
  } catch {
    document.getElementById('r-list').innerHTML = '<div style="padding:16px;text-align:center;font-size:12px;color:var(--red)">Error</div>'
  } finally { searchBusy = false }
}

// ── Structured search renderer ───────────────────────────────────
function sourceClass(value='') { return String(value).toLowerCase().replace(/[^a-z0-9_-]/g, '') }
function resultItems(catalog, kind) {
  if (kind === 'tracks') return catalog.tracks || []
  if (kind === 'albums') return catalog.albums || []
  if (kind === 'playlists') return catalog.playlists || []
  return [...(catalog.tracks || []), ...(catalog.albums || []), ...(catalog.playlists || [])]
}

function collectionRow(title, items, icon) {
  if (!items?.length) return null
  const wrap = document.createElement('div')
  wrap.innerHTML = `<div style="padding:14px 16px 4px;font-size:14px;font-weight:700;color:#fff">${icon} ${title}</div>`
  const row = document.createElement('div'); row.className = 'alb-row'
  row.innerHTML = items.slice(0, 20).map(item => `
    <div class="alb-card"
      data-uri="${esc(item.playUri || item.uri)}"
      data-title="${esc(item.title)}"
      data-author="${esc(item.author)}"
      data-art="${esc(item.artworkUrl || '')}"
      data-source="${esc(item.sourceName || item.type || '')}"
      data-meta="${esc(metaText(item, { limit: 4 }))}">
      <div class="alb-art-wrap">
        ${item.artworkUrl ? `<img class="alb-art" src="${esc(item.artworkUrl)}" onerror="this.style.display='none'">` : `<div class="alb-art-ph">${icon}</div>`}
        <button class="alb-play" title="Añadir colección"><i class="fas fa-play" style="margin-left:2px"></i></button>
      </div>
      <div class="alb-title">${esc(item.title)}</div>
      <div class="alb-artist">${esc(item.author)}</div>
      <div class="meta-chips">${metaChips(item, { limit: 3, type: true })}</div>
    </div>`).join('')
  row.querySelectorAll('.alb-card').forEach(card => {
    card.querySelector('.alb-play').addEventListener('click', event => { event.stopPropagation(); addTrack(card.dataset.uri) })
    card.addEventListener('click', () => {
      previewCollection(card.dataset.uri, {
        title: card.dataset.title,
        artworkUrl: card.dataset.art,
        subtitle: card.dataset.author + (card.dataset.meta ? ' · '+card.dataset.meta : ''),
      })
    })
  })
  wrap.appendChild(row)
  return wrap
}

function renderCatalog(container, catalog) {
  lastCatalog = {
    tracks: catalog?.tracks || catalog?.results || [],
    albums: catalog?.albums || [],
    playlists: catalog?.playlists || [],
  }
  const counts = {
    tracks: lastCatalog.tracks.length,
    albums: lastCatalog.albums.length,
    playlists: lastCatalog.playlists.length,
  }
  counts.all = counts.tracks + counts.albums + counts.playlists
  Object.entries(counts).forEach(([key, value]) => {
    const count = document.getElementById(`count-${key}`)
    if (count) count.textContent = value ? `(${value})` : ''
  })
  document.querySelectorAll('.r-tab').forEach(tab => tab.classList.toggle('active', tab.dataset.kind === activeResultKind))

  const visible = resultItems(lastCatalog, activeResultKind)
  if (!visible.length) {
    container.innerHTML = `<div class="r-empty"><i class="fas fa-compact-disc"></i>Sin ${activeResultKind === 'all' ? 'resultados' : activeResultKind} para esta búsqueda.</div>`
    return
  }

  const frag = document.createDocumentFragment()
  const top = visible[0]
  const topType = top.type === 'album' ? 'Álbum' : top.type === 'playlist' ? 'Playlist' : 'Canción'
  const topDetail = top.type === 'track' ? (top.isStream ? 'EN VIVO' : fmt(top.length)) : top.totalTracks ? `${top.totalTracks} pistas` : 'Colección'
  const topCard = document.createElement('div')
  topCard.className = 'top-result-card'
  topCard.innerHTML = `
    ${top.artworkUrl ? `<img class="top-result-art" src="${esc(top.artworkUrl)}" onerror="this.style.display='none'">` : '<div class="top-result-art ph">🎵</div>'}
    <div class="top-result-title">${esc(top.title)}</div>
    <div class="top-result-sub">
      <span>${esc(top.author)}</span><span class="top-result-badge">${topType}</span>
      <span style="margin-left:auto;font-size:11px;font-family:'JetBrains Mono',monospace">${topDetail}</span>
    </div>
    <div class="meta-chips" style="margin-bottom:12px">${metaChips(top, { limit: 4, isrc: true })}</div>
    <button class="btn-add-green"><i class="fas fa-circle-plus"></i> ${top.type === 'track' ? 'Añadir' : 'Ver pistas'}</button>`
  topCard.querySelector('.btn-add-green').addEventListener('click', function() {
    if (top.type === 'track') {
      addTrack(top.playUri || top.uri, this)
    } else {
      previewCollection(top.playUri || top.uri, {
        title: top.title,
        artworkUrl: top.artworkUrl,
        subtitle: top.author + (metaText(top, { limit: 4 }) ? ' · ' + metaText(top, { limit: 4 }) : ''),
      })
    }
  })
  frag.appendChild(topCard)

  if (activeResultKind === 'all' || activeResultKind === 'albums') {
    const albums = collectionRow('Álbumes', lastCatalog.albums, '💿')
    if (albums) frag.appendChild(albums)
  }
  if (activeResultKind === 'all' || activeResultKind === 'playlists') {
    const playlists = collectionRow('Playlists', lastCatalog.playlists, '📋')
    if (playlists) frag.appendChild(playlists)
  }
  if (activeResultKind === 'all' || activeResultKind === 'tracks') {
    const songsWrap = document.createElement('div')
    songsWrap.innerHTML = '<div style="padding:14px 16px 4px;font-size:14px;font-weight:700;color:#fff">🎵 Canciones</div>'
    const list = document.createElement('div'); list.className = 'sp-list'
    list.innerHTML = lastCatalog.tracks.slice(0, 20).map((track, index) => `
      <div class="sp-tr">
        <div class="sp-nwrap"><span class="sp-num">${index+1}</span><i class="fas fa-play sp-play-ico"></i></div>
        ${track.artworkUrl ? `<img class="sp-thumb" src="${esc(track.artworkUrl)}" onerror="this.src=''">`:'<div class="sp-thumb"></div>'}
        <div class="sp-info"><div class="sp-title">${esc(track.title)}</div><div class="sp-artist">${esc(track.author)}</div><div class="pr-meta">${esc(metaText(track, { limit: 3 }))}</div></div>
        <span class="sp-dur">${track.isStream ? 'LIVE' : fmt(track.length)}</span>
        <button class="sp-add" data-uri="${esc(track.uri)}" title="Añadir"><i class="fas fa-circle-plus"></i></button>
      </div>`).join('')
    list.querySelectorAll('.sp-add').forEach(button => button.addEventListener('click', () => addTrack(button.dataset.uri, button)))
    songsWrap.appendChild(list)
    frag.appendChild(songsWrap)
  }

  container.innerHTML = ''
  container.appendChild(frag)
}

// ── Add track ──────────────────────────────────────────────────────
// Pending URI while user picks a voice channel
let _pendingUri = null
let _pendingBtn = null

async function addTrack(uri, btn, voiceChannelId) {
  if (btn) {
    btn.innerHTML = btn.classList.contains('btn-add-green')
      ? '<i class="fas fa-spinner fa-spin"></i> Añadiendo…'
      : '<i class="fas fa-spinner fa-spin"></i>'
    btn.disabled = true
  }
  const body = { uri }
  if (voiceChannelId) body.voiceChannelId = voiceChannelId
  const r = await fetch(`/api/player/${GID}/add`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  }).then(r => r.json())

  if (btn) {
    if (r.ok) {
      btn.innerHTML = btn.classList.contains('btn-add-green') ? '<i class="fas fa-circle-check"></i> Añadido' : '<i class="fas fa-circle-check"></i>'
      btn.classList.add('added')
      setTimeout(() => {
        btn.innerHTML = btn.classList.contains('btn-add-green') ? '<i class="fas fa-circle-plus"></i> Añadir' : '<i class="fas fa-circle-plus"></i>'
        btn.classList.remove('added'); btn.disabled = false
      }, 1800)
    } else {
      btn.innerHTML = btn.classList.contains('btn-add-green') ? '<i class="fas fa-circle-plus"></i> Añadir' : '<i class="fas fa-circle-plus"></i>'
      btn.disabled = false
    }
  }

  if (r.ok) {
    if (r.added > 1)       toast(`✅ ${r.added} pistas añadidas a la cola`)
    else if (r.nowPlaying) toast('▶️ Reproduciendo ahora')
    else                   toast('📋 Añadido a la cola')
    // socket.io actualiza el estado automáticamente
  } else if (r.error === 'no_voice_channel') {
    _pendingUri = uri
    _pendingBtn = btn
    openVcModal()
  } else if (r.error === 'no_results') {
    toast('❌ No se encontró el track en YouTube', 'err')
  } else if (r.error === 'no_music') {
    toast('❌ Sistema de música no disponible', 'err')
  } else {
    toast('❌ ' + (r.error || 'Error'), 'err')
  }
}

async function openVcModal() {
  const modal = document.getElementById('vc-modal')
  const list  = document.getElementById('vc-list')
  modal.style.display = 'flex'
  list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:13px"><i class="fas fa-spinner fa-spin"></i> Cargando canales…</div>'
  try {
    const d = await fetch(`/api/player/${GID}/voice-channels`).then(r => r.json())
    if (!d.channels?.length) {
      list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:13px">Sin canales de voz disponibles</div>'
      return
    }
    list.innerHTML = d.channels.map(c => `
      <button class="vc-item" data-id="${esc(c.id)}">
        <i class="fas fa-volume-high" style="margin-right:8px;color:var(--muted)"></i>
        <span>${esc(c.name)}</span>
        ${c.members ? `<span class="vc-members">${c.members} 🎤</span>` : ''}
      </button>`).join('')
    list.querySelectorAll('.vc-item').forEach(btn => {
      btn.addEventListener('click', () => {
        closeVcModal()
        if (_pendingUri) addTrack(_pendingUri, _pendingBtn, btn.dataset.id)
        _pendingUri = null; _pendingBtn = null
      })
    })
  } catch {
    list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--red);font-size:13px">Error al cargar canales</div>'
  }
}

function closeVcModal() {
  document.getElementById('vc-modal').style.display = 'none'
}


// ── Preview modal (album/playlist tracks) ─────────────────────────
let _pvUri = null
let _pvTracks = []

function closePreview() {
  document.getElementById('preview-modal').classList.remove('show')
  _pvUri = null; _pvTracks = []
}

async function previewCollection(uri, meta = {}) {
  const title = meta.title || 'Colección'
  const art   = meta.artworkUrl || ''
  const sub   = meta.subtitle || ''
  document.getElementById('pv-title').textContent = title
  document.getElementById('pv-sub').textContent   = sub
  const pvArt = document.getElementById('pv-art')
  if (art) { pvArt.src = art; pvArt.style.display = 'block' }
  else { pvArt.style.display = 'none' }
  document.getElementById('pv-list').innerHTML =
    '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i>Cargando pistas…</div>'
  document.getElementById('preview-modal').classList.add('show')
  _pvUri = uri

  try {
    const r = await fetch(`/api/player/${GID}/preview`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ uri }),
    }).then(r => r.json())

    if (!r.ok || !r.tracks?.length) {
      document.getElementById('pv-list').innerHTML =
        '<div class="pr-empty"><i class="fas fa-circle-exclamation"></i>No se pudieron cargar las pistas</div>'
      return
    }

    _pvTracks = r.tracks
    const list = document.getElementById('pv-list')
    list.innerHTML = r.tracks.map((t, i) => `
      <div class="pr-tr" data-uri="${esc(t.uri)}">
        <div class="pr-nwrap"><span class="pr-num">${i+1}</span></div>
        ${t.artworkUrl ? `<img class="pr-thumb" src="${esc(t.artworkUrl)}" onerror="this.src=''">` : '<div class="pr-thumb"></div>'}
        <div class="pr-info"><div class="pr-title">${esc(t.title)}</div><div class="pr-author">${esc(t.author)}</div><div class="pr-meta">${esc(metaText(t, { limit: 3, isrc: true }))}</div></div>
        <span class="pr-dur">${t.isStream ? 'LIVE' : fmt(t.length)}</span>
        <button class="pr-add" title="Añadir"><i class="fas fa-circle-plus"></i></button>
      </div>`).join('')
    list.querySelectorAll('.pr-add').forEach(btn => {
      btn.addEventListener('click', function() {
        const tr = this.closest('.pr-tr')
        addTrack(tr.dataset.uri, this)
      })
    })
  } catch {
    document.getElementById('pv-list').innerHTML =
      '<div class="pr-empty"><i class="fas fa-circle-exclamation"></i>Error al cargar</div>'
  }
}

async function previewAddAll() {
  if (!_pvUri) return
  const btn = document.getElementById('pv-add-all')
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Añadiendo…'
  btn.disabled = true
  try {
    const r = await fetch(`/api/player/${GID}/add`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ uri: _pvUri }),
    }).then(r => r.json())

    if (r.ok) {
      toast(r.added > 1 ? `✅ ${r.added} pistas añadidas a la cola` : '▶️ Reproduciendo ahora')
      closePreview()
    } else if (r.error === 'no_voice_channel') {
      _pendingUri = _pvUri
      _pendingBtn = null
      closePreview()
      openVcModal()
    } else {
      toast('❌ ' + (r.error || 'Error al añadir'), 'err')
    }
  } catch {
    toast('Error de red', 'err')
  } finally {
    btn.innerHTML = '<i class="fas fa-circle-plus"></i> Añadir todo'
    btn.disabled = false
  }
}

// ── Player state ───────────────────────────────────────────────────
async function loadPlayer() {
  if (playerLoadBusy) return
  playerLoadBusy = true
  try {
    const d = await fetch(`/api/player/${GID}`, { cache: 'no-store' }).then(r=>r.json())
    st = d
    render(d)
  } catch {
  } finally {
    playerLoadBusy = false
  }
}

function render(d) {
  const idle   = document.getElementById('np-idle')
  const mp     = document.getElementById('mini-player')
  const topSt  = document.getElementById('top-status')

  const nowBar = document.getElementById('ct-now-bar')

  if (!d?.active) {
    if (idle) idle.style.display = 'flex'
    if (nowBar) nowBar.style.display = 'none'
    mp.classList.remove('show')
    topSt.textContent = 'Sin música'; topSt.className = 'tb-status idle'
    renderQueue([], 0)
    clearInterval(progTimer); _stopRaf()
    document.getElementById('app-bg').style.backgroundImage = 'none'
    document.getElementById('pulse-state').textContent = 'Sin reproducción'
    document.getElementById('pulse-queue').textContent = 'Cola vacía'
    document.getElementById('pulse-history').textContent = serverSeedTracks.length ? `${serverSeedTracks.length} favoritas guardadas` : 'Sin historial reciente'
    document.getElementById('server-room-copy').textContent = 'Controla lo que suena en el canal de voz y descubre música basada en la actividad real de este servidor.'
    return
  }

  if (nowBar) nowBar.style.display = 'flex'
  if (idle) idle.style.display = 'none'
  mp.classList.add('show')
  topSt.textContent = d.paused ? '⏸ Pausado' : '▶ Reproduciendo'
  topSt.className   = 'tb-status' + (d.paused ? ' paused' : ' playing')

  const c = d.current
  document.getElementById('pulse-state').textContent = d.paused ? `Pausado: ${c.title}` : `Sonando: ${c.title}`
  document.getElementById('pulse-queue').textContent = d.queueTotal ? `${d.queueTotal} en cola` : 'Cola vacía'
  document.getElementById('pulse-history').textContent = d.history?.length ? `${d.history.length} recientes` : (serverSeedTracks.length ? `${serverSeedTracks.length} favoritas` : 'Sin historial reciente')
  document.getElementById('server-room-copy').textContent = c.author ? `${c.author} está sonando ahora en Discord. La web queda sincronizada con pausa, cola y posición.` : 'La web queda sincronizada con Discord en tiempo real.'
  const art   = document.getElementById('mp-art')
  const artPh = document.getElementById('mp-art-ph')
  if (c.artworkUrl) {
    const safe = /^https:\/\/[^\s'"<>]+$/.test(c.artworkUrl) ? c.artworkUrl : ''
    art.src = c.artworkUrl; art.style.display = 'block'; artPh.style.display = 'none'
    document.getElementById('app-bg').style.backgroundImage = safe ? `url("${safe}")` : 'none'
  } else {
    art.style.display = 'none'; artPh.style.display = 'flex'
    document.getElementById('app-bg').style.backgroundImage = 'none'
  }

  document.getElementById('mp-title').textContent  = c.title
  document.getElementById('mp-artist').textContent = c.albumName ? `${c.author} · ${c.albumName}` : c.author
  document.getElementById('mc-pp-ico').className   = d.paused ? 'fas fa-play' : 'fas fa-pause'

  // Center: now-bar
  const ctArt = document.getElementById('ct-art')
  const ctArtPh = document.getElementById('ct-art-ph')
  if (c.artworkUrl) {
    ctArt.src = c.artworkUrl; ctArt.style.display = 'block'; ctArtPh.style.display = 'none'
  } else {
    ctArt.style.display = 'none'; ctArtPh.style.display = 'flex'
  }
  document.getElementById('ct-title').textContent  = c.title
  document.getElementById('ct-artist').textContent = c.author
  document.getElementById('ct-meta').innerHTML = metaChips(c, { limit: 4, requester: true })
  // Next mini pills
  const mini = document.getElementById('ct-next-mini')
  if (mini) {
    const upcoming = (d.queue || []).filter(t => t.pos > 0).slice(0, 3)
    mini.innerHTML = upcoming.map(t =>
      `<div class="ct-mini-pill"><span>${esc(t.title)}</span></div>`
    ).join('')
  }

  if (!dirty) {
    document.getElementById('mp-vol').value = d.volume
    setVolIco(d.volume)
  }

  document.getElementById('mc-loop').className    = 'mc-btn' + (d.loop !== 'none' ? ' lit' : '')
  document.getElementById('mc-shuffle').className = 'mc-btn' + (d.shuffle ? ' lit' : '')
  document.getElementById('mc-ap').className      = 'mp-queue-toggle' + (d.autoplay ? ' lit' : '')

  elapsed = c.elapsed
  document.getElementById('mp-total').textContent = fmt(c.length)
  if (!d.paused && c.length > 0) {
    const sameTrack = _playing && _rafUri === c.uri
    if (sameTrack) {
      // Misma canción corriendo — solo corregir si hay deriva grande (seek)
      const clientNow = _syncElapsed + (performance.now() - _syncAt)
      if (Math.abs(c.elapsed - clientNow) > 2000) {
        _syncAt = performance.now(); _syncElapsed = c.elapsed; _syncLength = c.length
      }
    } else {
      // Canción nueva o pausa→play — reiniciar RAF desde la posición del servidor
      _rafUri = c.uri
      _startRaf(c.elapsed, c.length)
    }
  } else {
    _stopRaf()
    document.getElementById('mp-prog-fill').style.width = (c.length > 0 ? (c.elapsed/c.length*100) : 0)+'%'
    document.getElementById('mp-cur').textContent = fmt(c.elapsed)
  }

  renderQueue(d.queue, d.queueTotal, d.paused)
}

function seekClick(e) {
  if (!st?.current?.isSeekable || st?.current?.isStream) {
    toast('Esta pista no permite cambiar la posición', 'info')
    return
  }
  const rect = e.currentTarget.getBoundingClientRect()
  const pos  = Math.floor((st?.current?.length||0) * ((e.clientX-rect.left)/rect.width))
  // Actualizar la barra al instante; el servidor confirmará vía player:state
  _syncAt = performance.now(); _syncElapsed = pos
  document.getElementById('mp-prog-fill').style.width = (_syncLength > 0 ? (pos/_syncLength*100) : 0) + '%'
  document.getElementById('mp-cur').textContent = fmt(pos)
  ctrl('seek', pos)
}

// ── Home section renderers ────────────────────────────────────────
function renderHcards(container, tracks, showPlays) {
  if (!tracks?.length) { container.innerHTML = ''; return }
  container.innerHTML = tracks.slice(0, 10).map(t => {
    const isAlbum    = t.type === 'album'
    const isPlaylist = t.type === 'playlist'
    const isCollection = isAlbum || isPlaylist
    const typeLabel  = isAlbum ? '💿 Álbum' : isPlaylist ? '📋 Playlist' : ''
    const ph         = isAlbum ? '💿' : isPlaylist ? '📋' : '🎵'
    return `<div class="hcard${isCollection ? ' hcard-collection' : ''}" data-uri="${esc(t.playUri || t.uri)}" data-type="${esc(t.type || 'track')}" data-title="${esc(t.title)}" data-author="${esc(t.author)}" data-art="${esc(t.artworkUrl || '')}" data-source="${esc(t.sourceName || '')}" data-meta="${esc(metaText(t, { limit: 3 }))}">
      <div class="hcard-art-wrap">
        ${t.artworkUrl ? `<img class="hcard-art" src="${esc(t.artworkUrl)}" onerror="this.style.display='none'">` : `<div class="hcard-art-ph">${ph}</div>`}
        <button class="hcard-play" title="${isCollection ? 'Ver contenido' : 'Añadir a cola'}"><i class="fas fa-${isCollection ? 'chevron-right' : 'play'}" style="margin-left:${isCollection ? '0' : '2'}px"></i></button>
      </div>
      <div class="hcard-title">${esc(t.title)}</div>
      <div class="hcard-artist">${esc(t.author)}</div>
      ${typeLabel ? `<div class="hcard-type-label">${typeLabel}</div>` : (showPlays && t.plays ? `<div class="hcard-plays">▶ ${t.plays} ${t.plays===1?'vez':'veces'}</div>` : '')}
    </div>`
  }).join('')
  container.querySelectorAll('.hcard').forEach(card => {
    const isCollection = card.dataset.type === 'album' || card.dataset.type === 'playlist'
    card.querySelector('.hcard-play').addEventListener('click', e => { e.stopPropagation(); addTrack(card.dataset.uri) })
    card.addEventListener('click', () => {
      if (isCollection) {
        previewCollection(card.dataset.uri, {
          title: card.dataset.title,
          artworkUrl: card.dataset.art,
          subtitle: card.dataset.author + (card.dataset.meta ? ' · '+card.dataset.meta : ''),
        })
      } else {
        addTrack(card.dataset.uri)
      }
    })
  })
}

async function loadSection(id, query, kind = 'tracks', source = 'all', retries = 1) {
  const row = document.getElementById(id); if (!row) return
  try {
    const d = await searchAPI(query, source, kind)
    const items = d[kind] || (kind === 'tracks' ? d.results : []) || []
    if (items.length) { renderHcards(row, items); return }
    // No results or auth error — retry once after 3s
    if (retries > 0) { setTimeout(() => loadSection(id, query, kind, source, retries - 1), 3000); return }
    row.innerHTML = `<div style="padding:16px 20px;color:var(--muted);font-size:12px;opacity:.65">Sin ${kind === 'albums' ? 'álbumes' : kind === 'playlists' ? 'playlists' : 'resultados'} disponibles.</div>`
  } catch {
    if (retries > 0) { setTimeout(() => loadSection(id, query, kind, source, retries - 1), 3000); return }
    row.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:12px;opacity:.5">Error al cargar</div>'
  }
}

async function loadMultiSection(id, queries, kind = 'tracks', source = 'all', excludedUris = new Set()) {
  const row = document.getElementById(id); if (!row) return
  const seen = new Set()
  const items = []
  try {
    const responses = await Promise.all(queries.map(query => searchAPI(query, source, kind).catch(() => null)))
    const pools = responses.map(d => d?.[kind] || [])
    const maxPoolSize = Math.max(0, ...pools.map(pool => pool.length))
    for (let index = 0; index < maxPoolSize && items.length < 10; index++) {
      for (const pool of pools) {
        const item = pool[index]
        if (!item) continue
        const key = item.uri || `${item.title}:${item.author}`
        if (!key || seen.has(key) || excludedUris.has(item.uri)) continue
        seen.add(key)
        items.push(item)
        if (items.length >= 10) break
      }
    }
    if (items.length) renderHcards(row, items)
    else row.innerHTML = `<div style="padding:16px 20px;color:var(--muted);font-size:12px;opacity:.65">Sin ${kind === 'albums' ? 'álbumes' : kind === 'playlists' ? 'playlists' : 'resultados'} disponibles.</div>`
    return items
  } catch {
    row.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:12px;opacity:.5">Error al cargar</div>'
    return []
  }
}

async function loadServerDiscovery(seeds = serverSeedTracks) {
  const copy = document.getElementById('server-mix-copy')
  const knownUris = new Set((seeds || []).map(track => track.uri).filter(Boolean))
  const artists = [...new Set((seeds || []).map(track => track.author).filter(Boolean))].slice(0, 6)
  const queries = artists.length
    ? artists.map(artist => `${artist} radio canciones similares`)
    : [
        'urbano latino novedades',
        'pop alternativo novedades',
        'reggaeton viral',
        'electrónica nuevos lanzamientos',
        'rock alternativo actual',
        'r&b nuevos artistas',
      ]

  if (copy) {
    copy.textContent = artists.length
      ? `Basado en ${artists.slice(0, 3).join(', ')} y el historial de este servidor`
      : 'Primeras recomendaciones variadas mientras el servidor crea su historial'
  }
  serverMixItems = await loadMultiSection('section-pop', queries, 'tracks', 'all', knownUris) || []
}

function playServerMix() {
  const seed = serverSeedTracks[0] || serverMixItems[0]
  if (seed?.author) {
    discoverSearch(`${seed.author} radio canciones similares`)
    return
  }
  discoverSearch('urbano pop alternativo novedades mix')
}

async function loadTopTracks() {
  const row = document.getElementById('section-top')
  const hd  = document.getElementById('top-hd')
  try {
    const d = await fetch(`/api/player/${GID}/top-tracks`).then(r => r.json())
    serverSeedTracks = d.tracks || []
    if (d.tracks?.length) {
      renderHcards(row, d.tracks, true)
      hd.style.display = 'flex'
    } else {
      hd.style.display = 'none'
    }
    await loadServerDiscovery(serverSeedTracks)
  } catch {
    hd.style.display = 'none'
    await loadServerDiscovery([])
  }
}

// ── Queue renderer ─────────────────────────────────────────────────
function renderQueue(queue, total, paused) {
  const list = document.getElementById('q-list')
  document.getElementById('q-count').textContent = total ? `(${total})` : ''
  if (!queue?.length) {
    list.innerHTML = '<div style="padding:32px 16px;text-align:center;color:var(--muted);opacity:.35;font-size:13px"><i class="fas fa-music" style="display:block;font-size:22px;margin-bottom:10px;opacity:.3"></i>Cola vacía</div>'
    return
  }
  list.innerHTML = queue.map(t => `
    <div class="qi${t.pos===0?` active${paused?' paused':''}`:''}" data-pos="${t.pos}">
      <div class="qi-nwrap">
        <div class="qi-eq"><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div></div>
        <span class="qi-num">${t.pos===0?'♫':t.pos}</span>
        <i class="fas fa-play qi-play-ico"></i>
      </div>
      ${t.artworkUrl?`<img class="qi-thumb" src="${esc(t.artworkUrl)}" onerror="this.src=''">`:'<div class="qi-thumb"></div>'}
      <div class="qi-info"><div class="qi-title">${esc(t.title)}</div><div class="qi-author">${esc(t.author)}</div><div class="pr-meta">${esc(metaText(t, { limit: 2 }))}</div></div>
      <span class="qi-dur">${t.isStream ? 'LIVE' : fmt(t.length)}</span>
      ${t.pos > 0 ? `<div class="qi-btns">
        <button class="qi-btn" data-pos="${t.pos}" title="Saltar"><i class="fas fa-play"></i></button>
        <button class="qi-btn del" data-pos="${t.pos}" title="Eliminar"><i class="fas fa-xmark"></i></button>
      </div>` : '<div></div>'}
    </div>`).join('')
  list.querySelectorAll('.qi-btn:not(.del)').forEach(b => b.addEventListener('click', () => ctrl('jump', +b.dataset.pos)))
  list.querySelectorAll('.qi-btn.del').forEach(b => b.addEventListener('click', () => ctrl('remove', +b.dataset.pos)))
}

// ── Controls ───────────────────────────────────────────────────────
async function ctrl(act, val) {
  const body = {action:act}; if (val !== undefined) body.value = val
  try {
    const r = await fetch(`/api/player/${GID}/action`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json())
    if (!r.ok) { toast(r.error||'Error','err'); return }
    setTimeout(loadPlayer, 180)
  } catch { toast('Error de red','err') }
}
function cycleLoop() {
  ctrl('loop', (st?.loop||'none')==='none' ? 'track' : st?.loop==='track' ? 'queue' : 'none')
}
async function clearQueue() { if(!confirm('¿Limpiar la cola?')) return; ctrl('stop') }
let vDeb
function onVolInput(v) {
  dirty = true; setVolIco(+v)
  clearTimeout(vDeb); vDeb = setTimeout(() => setVol(v), 400)
}
function setVol(v) { dirty = false; ctrl('volume', v) }
function setVolIco(v) {
  document.getElementById('mp-vol-ico').className =
    `fas ${v==0?'fa-volume-xmark':v<60?'fa-volume-low':'fa-volume-high'} mp-vol-ico`
}

// ── Responsive panel helpers ───────────────────────────────────────
function closeAllPanels() {
  document.querySelector('.col-queue')?.classList.remove('open')
  document.querySelector('.col-right')?.classList.remove('open')
  document.getElementById('drawer-backdrop')?.classList.remove('show')
  document.getElementById('tb-srch-toggle')?.classList.remove('active')
}
function toggleRightPanel() {
  const right = document.querySelector('.col-right')
  const isOpen = right?.classList.contains('open')
  closeAllPanels()
  if (!isOpen) {
    right?.classList.add('open')
    document.getElementById('tb-srch-toggle')?.classList.add('active')
    document.getElementById('drawer-backdrop')?.classList.add('show')
  }
}
function mobileTab(tab) {
  closeAllPanels()
  document.querySelectorAll('.mn-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab))
  if (tab === 'queue') { document.querySelector('.col-queue')?.classList.add('open'); document.getElementById('drawer-backdrop')?.classList.add('show') }
  else if (tab === 'search') { document.querySelector('.col-right')?.classList.add('open'); document.getElementById('drawer-backdrop')?.classList.add('show') }
}

// ── Keyboard ──────────────────────────────────────────────────────
document.addEventListener('keydown', e => {
  if (['INPUT','TEXTAREA'].includes(e.target.tagName)) return
  const modal = document.getElementById('kb-modal')
  if (modal.classList.contains('show')) { if(e.key==='Escape')modal.classList.remove('show'); return }
  switch(e.key) {
    case ' ':         e.preventDefault(); ctrl('pause'); break
    case 'ArrowRight': ctrl('skip');       break
    case 'ArrowLeft':  ctrl('previous');   break
    case 'ArrowUp':   e.preventDefault(); { const v=Math.min(200,+document.getElementById('mp-vol').value+10); document.getElementById('mp-vol').value=v; onVolInput(v); setVol(v) } break
    case 'ArrowDown': e.preventDefault(); { const v=Math.max(0,+document.getElementById('mp-vol').value-10);   document.getElementById('mp-vol').value=v; onVolInput(v); setVol(v) } break
    case 's': case 'S': ctrl('shuffle'); break
    case 'l': case 'L': cycleLoop();     break
    case 'x': case 'X': ctrl('stop');   break
    case 'f': case 'F': document.getElementById('s-inp').focus(); break
    case '?': modal.classList.add('show'); break
    case 'Escape': modal.classList.remove('show'); break
  }
})

// ── Init ──────────────────────────────────────────────────────────
buildGenreGrid()
document.querySelectorAll('.r-tab').forEach(button => {
  button.addEventListener('click', () => {
    activeResultKind = button.dataset.kind || 'all'
    renderCatalog(document.getElementById('r-list'), lastCatalog)
  })
})
loadTopTracks()
Promise.all([
  loadMultiSection('section-trending', [
    'top global hits today',
    'viral hits today',
    'today top hits',
    'pop hits 2026',
    'latin hits 2026',
    'reggaeton hits 2026',
    'dance hits 2026',
    'new music hits',
  ], 'tracks', 'all'),
  loadMultiSection('section-rock', ['Bad Bunny', 'Drake', 'Taylor Swift', 'Billie Eilish', 'Karol G'], 'albums', 'all'),
])
loadPlayer()
// Socket.IO: updates en tiempo real
const socket = io()
socket.on('connect', () => {
  socket.emit('join', GID)
  loadPlayer()
})
socket.on('player:state', d => { st = d; render(d) })
socket.on('player:tick',  d => {
  if (!st?.active || st?.paused || !_playing) return
  // Solo re-sincroniza si hay deriva real (>2s) — evita saltos por lag de red normal
  const clientNow = _syncElapsed + (performance.now() - _syncAt)
  if (Math.abs(d.elapsed - clientNow) > 2000) {
    _syncAt = performance.now(); _syncElapsed = d.elapsed; _syncLength = d.length
  }
})
socket.on('player:error', d => toast(d?.error || 'No se pudo conectar al reproductor', 'err'))
socket.on('connect_error', () => loadPlayer())
setInterval(loadPlayer, 30000)
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible') loadPlayer()
})
</script>
</body>
</html>
