<% const text = form.messages; %>
<%- include('../includes/header', { title: guild.name + ' — ' + text.title, user, activePage: 'welcome', breadcrumb: [{ label: 'Mis Servidores', url: '/dashboard' }, { label: guild.name, url: '/dashboard/' + guild.id }, { label: text.title }] }) %>
<link rel="stylesheet" href="/css/configuration-editor.css">
<section id="configuration-editor" lang="<%= form.locale %>" data-guild-id="<%= guild.id %>" data-module-id="<%= moduleId %>">
  <div class="configuration-heading"><div><a href="/dashboard/<%= guild.id %>">← <%= guild.name %></a><h1><%= text.title %></h1><p><%= text.description %></p></div><button type="button" class="btn btn-sec" id="config-refresh"><%= text.refresh %></button></div>
  <p id="config-status" role="status" aria-live="polite" tabindex="-1"><%= text.loading %></p>
  <div class="configuration-grid">
    <section class="card" aria-labelledby="config-published-title"><div class="card-head"><h2 id="config-published-title"><%= text.published %></h2></div><div class="card-body">
      <p id="config-published-channel"><%= text.readingChannel %></p><pre id="config-published-message"></pre><p id="config-published-date" class="configuration-note"></p>
      <p class="configuration-note"><%= text.scopeNote %></p>
    </div></section>
    <section class="card" aria-labelledby="config-draft-title"><div class="card-head"><h2 id="config-draft-title"><%= text.draft %></h2></div><div class="card-body">
      <form id="config-form"><fieldset id="config-fields" disabled><legend class="sr-only"><%= text.draft %></legend>
        <%- include('../includes/configuration-fields', { form }) %>
        <p id="config-draft-detail" class="configuration-note"></p>
        <div class="configuration-actions"><button type="button" class="btn btn-sec" id="config-preview"><%= text.previewButton %></button><button type="submit" class="btn btn-sec" id="config-save"><%= text.saveButton %></button><button type="button" class="btn btn-p" id="config-publish" disabled><%= text.publishButton %></button><button type="button" class="btn btn-sec" id="config-discard" disabled><%= text.discardButton %></button></div>
      </fieldset></form>
      <p id="config-conflict" role="alert" hidden></p>
    </div></section>
  </div>
  <section class="card" aria-labelledby="config-review-title"><div class="card-head"><h2 id="config-review-title"><%= text.changesTitle %></h2></div><div class="card-body"><p id="config-review-empty"><%= text.noChanges %></p><dl id="config-diff"></dl><p id="config-other-draft" class="configuration-note" hidden></p></div></section>
  <section class="card" id="config-preview-panel" aria-labelledby="config-preview-title" hidden><div class="card-head"><h2 id="config-preview-title"><%= text.previewTitle %></h2></div><div class="card-body"><pre id="config-preview-content"></pre></div></section>
</section>
<script type="application/json" id="config-copy"><%- JSON.stringify(text).replace(/</g, '\\u003c') %></script>
<script src="/js/configuration-editor.js"></script>
<%- include('../includes/footer') %>
