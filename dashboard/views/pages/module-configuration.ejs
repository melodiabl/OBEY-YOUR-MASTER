<%- include('../includes/header', { title: guild.name + ' — Bienvenida', user, activePage: 'servers', breadcrumb: [{ label: 'Mis Servidores', url: '/dashboard' }, { label: guild.name, url: '/dashboard/' + guild.id }, { label: 'Bienvenida' }] }) %>
<link rel="stylesheet" href="/css/module-configuration.css">
<section id="module-configuration" data-guild-id="<%= guild.id %>" data-module-id="<%= moduleId %>">
  <div class="module-config-heading"><div><a href="/dashboard/<%= guild.id %>">← <%= guild.name %></a><h1>Bienvenida</h1><p>Prepara el mensaje de entrada y revisa los cambios antes de publicarlos.</p></div><button type="button" class="btn btn-sec" id="config-refresh">Actualizar y comparar</button></div>
  <p id="config-status" role="status" aria-live="polite">Cargando configuración…</p>
  <div class="module-config-grid">
    <section class="card" aria-labelledby="config-published-title"><div class="card-head"><h2 id="config-published-title">Publicado</h2></div><div class="card-body">
      <p id="config-published-channel">Leyendo canal…</p><pre id="config-published-message"></pre><p id="config-published-date" class="module-config-note"></p>
      <p class="module-config-note">Esta es la configuración que utiliza el bot. Las opciones de tarjetas, mensajes privados y otros ajustes existentes se conservan.</p>
    </div></section>
    <section class="card" aria-labelledby="config-draft-title"><div class="card-head"><h2 id="config-draft-title">Borrador</h2></div><div class="card-body">
      <form id="config-form"><fieldset id="config-fields" disabled><legend class="sr-only">Canal y mensaje de entrada</legend>
        <label for="config-channel">Canal de bienvenida</label><select id="config-channel" aria-describedby="config-channel-help"></select>
        <p id="config-channel-help" class="module-config-note">Puedes desactivar el envío a este canal. Los mensajes privados y el segundo canal conservan su configuración.</p>
        <label for="config-message">Mensaje de entrada</label><textarea id="config-message" maxlength="500" rows="5" aria-describedby="config-message-help"></textarea>
        <p id="config-message-help" class="module-config-note">Hasta 500 caracteres. Variables: {user}, {usertag}, {username}, {guild}, {server}, {count}.</p>
        <p id="config-draft-detail" class="module-config-note"></p>
        <div class="module-config-actions"><button type="button" class="btn btn-sec" id="config-preview">Vista previa</button><button type="submit" class="btn btn-sec" id="config-save">Guardar borrador</button><button type="button" class="btn btn-p" id="config-publish" disabled>Publicar borrador</button></div>
      </fieldset></form>
      <p id="config-conflict" role="alert" hidden></p>
    </div></section>
  </div>
  <section class="card" aria-labelledby="config-review-title"><div class="card-head"><h2 id="config-review-title">Cambios para revisar</h2></div><div class="card-body"><p id="config-review-empty">No hay cambios pendientes.</p><dl id="config-diff"></dl><p id="config-other-draft" class="module-config-note" hidden></p></div></section>
  <section class="card" id="config-preview-panel" aria-labelledby="config-preview-title" hidden><div class="card-head"><h2 id="config-preview-title">Vista previa con datos ficticios</h2></div><div class="card-body"><pre id="config-preview-content"></pre></div></section>
</section>
<script src="/js/module-configuration.js"></script>
<%- include('../includes/footer') %>
