<%- include('../includes/header', { title: 'Dashboard - Servidores', user }) %>

<div class="container">
  <h2><i class="fas fa-server"></i> Tus Servidores</h2>
  <p class="subtitle">Selecciona un servidor para configurarlo.</p>
  <div class="guild-grid">
    <% guilds.forEach(guild => { %>
      <div class="guild-card <%= guild.inBot ? '' : 'not-in-bot' %>">
        <% if (guild.icon) { %>
          <img src="<%= guild.icon %>" alt="<%= guild.name %>" class="guild-icon">
        <% } else { %>
          <div class="guild-icon-placeholder"><%= guild.name[0] %></div>
        <% } %>
        <h3><%= guild.name %></h3>
        <% if (guild.inBot) { %>
          <a href="/dashboard/<%= guild.id %>" class="btn-manage">Gestionar <i class="fas fa-arrow-right"></i></a>
        <% } else { %>
          <a href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&scope=bot&permissions=8" target="_blank" class="btn-invite">Invitar Bot <i class="fas fa-plus"></i></a>
        <% } %>
      </div>
    <% }) %>
    <% if (!guilds.length) { %>
      <p class="empty">No tienes servidores con permiso de administración.</p>
    <% } %>
  </div>
</div>

<%- include('../includes/footer') %>
