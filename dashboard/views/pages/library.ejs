<%- include('../includes/header', {
  title: guild.name + ' — Mi Biblioteca',
  user,
  breadcrumb
}) %>

<div class="page-hd">
  <div class="page-ico ico-p"><i class="fas fa-compact-disc"></i></div>
  <div>
    <div class="page-title">MI BIBLIOTECA</div>
    <div class="page-sub"><%= guild.name %> · tus favoritos, playlists y más</div>
  </div>
  <div class="page-actions">
    <a href="/player/<%= guild.id %>" class="btn btn-ghost btn-sm"><i class="fas fa-play"></i> Reproductor</a>
    <a href="/dashboard/<%= guild.id %>" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Servidor</a>
  </div>
</div>

<style>
  .lib-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
  .lib-tab{padding:9px 16px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);cursor:pointer;font-weight:600;color:var(--txt2,#b9bbbe);transition:.15s;display:flex;gap:8px;align-items:center}
  .lib-tab:hover{background:rgba(255,255,255,.07)}
  .lib-tab.active{background:linear-gradient(135deg,#1DB954,#13833b);color:#fff;border-color:transparent}
  .lib-pane{display:none}
  .lib-pane.active{display:block;animation:fade .25s}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1}}
  .lib-row{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);margin-bottom:8px}
  .lib-row:hover{background:rgba(255,255,255,.06)}
  .lib-art{width:48px;height:48px;border-radius:8px;object-fit:cover;background:#222;flex:none}
  .lib-meta{flex:1;min-width:0}
  .lib-title{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lib-sub{font-size:.82rem;color:var(--txt2,#9a9da3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lib-num{width:26px;text-align:center;color:var(--txt2,#888);font-weight:700;flex:none}
  .lib-act{display:flex;gap:6px;flex:none}
  .ib{width:36px;height:36px;border-radius:9px;border:none;cursor:pointer;background:rgba(255,255,255,.06);color:#fff;display:grid;place-items:center;transition:.15s}
  .ib:hover{background:#1DB954}
  .ib.danger:hover{background:#ED4245}
  .lib-empty{text-align:center;padding:40px;color:var(--txt2,#888)}
  .lib-empty i{font-size:2.4rem;opacity:.4;display:block;margin-bottom:10px}
  .lib-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
  .pl-card{padding:16px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)}
  .pl-card h4{margin:0 0 4px;font-size:1.05rem}
  .lib-loading{text-align:center;padding:30px;color:var(--txt2,#888)}
</style>

<div class="lib-tabs">
  <div class="lib-tab active" data-pane="fav"><i class="fas fa-heart" style="color:#ED4245"></i> Favoritos</div>
  <div class="lib-tab" data-pane="pl"><i class="fas fa-folder" style="color:#FAA61A"></i> Playlists</div>
  <div class="lib-tab" data-pane="rec"><i class="fas fa-clock" style="color:#5865F2"></i> Recientes</div>
  <div class="lib-tab" data-pane="top"><i class="fas fa-chart-line" style="color:#1DB954"></i> Top del servidor</div>
</div>

<div class="lib-pane active" id="pane-fav"><div class="lib-loading">Cargando favoritos…</div></div>
<div class="lib-pane" id="pane-pl"><div class="lib-loading">Cargando playlists…</div></div>
<div class="lib-pane" id="pane-rec"><div class="lib-loading">Cargando recientes…</div></div>
<div class="lib-pane" id="pane-top"><div class="lib-loading">Cargando top…</div></div>

<script>
const GID = '<%= guild.id %>'
const esc = s => String(s ?? '').replace(/[&<>"'`\\]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','`':'&#96;','\\':'&#92;'}[c]))
const fmt = ms => { const s = Math.floor((ms||0)/1000); return `${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}` }
const toast = (m, ok=true) => { const t=document.getElementById('toasts'); if(!t)return alert(m); const d=document.createElement('div'); d.textContent=m; d.style.cssText=`background:${ok?'#1DB954':'#ED4245'};color:#fff;padding:10px 16px;border-radius:10px;margin-top:8px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.4)`; t.appendChild(d); setTimeout(()=>d.remove(),3500) }

async function api(url, opts){ const r = await fetch(url, opts); const j = await r.json().catch(()=>({})); return { ok:r.ok, j } }

async function play(uri){
  const { ok, j } = await api(`/api/player/${GID}/add`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ uri }) })
  if (ok && j.ok !== false) toast('🎵 Añadido a la cola')
  else toast(j.error === 'no_voice_channel' ? 'Inicia la reproducción desde un canal de voz primero' : 'No se pudo reproducir', false)
}
async function unlike(trackId, el){
  const { ok } = await api('/api/music/like', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ trackId }) })
  if (ok){ el.closest('.lib-row')?.remove(); toast('💔 Quitado de favoritos') } else toast('Error', false)
}

function rowHtml(t, i, { rm, count } = {}){
  const art = t.artworkUrl || t.artwork || `https://placehold.co/48?text=♪`
  const dur = t.isStream ? 'LIVE' : (t.length ? fmt(t.length) : (count ? `${count} ▶` : ''))
  return `<div class="lib-row" data-uri="${esc(t.uri||'')}" data-trackid="${esc(t.trackId||'')}">
    <div class="lib-num">${i+1}</div>
    <img class="lib-art" src="${esc(art)}" onerror="this.src='https://placehold.co/48?text=♪'">
    <div class="lib-meta"><div class="lib-title">${esc(t.title||'?')}</div><div class="lib-sub">${esc(t.author||'?')} ${dur?'· '+dur:''}</div></div>
    <div class="lib-act">
      <button class="ib js-play" title="Reproducir"><i class="fas fa-play"></i></button>
      ${rm ? `<button class="ib danger js-unlike" title="Quitar"><i class="fas fa-heart-broken"></i></button>` : ''}
    </div></div>`
}
const empty = (icon, msg) => `<div class="lib-empty"><i class="fas ${icon}"></i>${msg}</div>`

// Delegación: los valores no confiables viajan en data-* (esc HTML basta ahí), nunca en onclick
document.addEventListener('click', e => {
  const p = e.target.closest('.js-play')
  if (p){ const row = p.closest('.lib-row'); if (row) play(row.dataset.uri || ''); return }
  const d = e.target.closest('.js-unlike')
  if (d){ const row = d.closest('.lib-row'); if (row) unlike(row.dataset.trackid || '', d) }
})

async function loadFav(){
  const { ok, j } = await api('/api/music/liked')
  const el = document.getElementById('pane-fav')
  if (!ok || !j.data?.length) return el.innerHTML = empty('fa-heart', 'No tienes canciones favoritas. Usa ❤️ en el bot.')
  el.innerHTML = j.data.map((t,i)=>rowHtml(t,i,{rm:true})).join('')
}
async function loadRec(){
  const { ok, j } = await api('/api/music/recent')
  const el = document.getElementById('pane-rec')
  if (!ok || !j.data?.length) return el.innerHTML = empty('fa-clock', 'No hay reproducciones recientes todavía.')
  el.innerHTML = j.data.map((t,i)=>rowHtml(t,i,{count:t.playCount})).join('')
}
async function loadPl(){
  const { ok, j } = await api('/api/playlist/list')
  const el = document.getElementById('pane-pl')
  if (!ok || !j.data?.length) return el.innerHTML = empty('fa-folder-open', 'No tienes playlists todavía.')
  el.innerHTML = '<div class="lib-grid">' + j.data.map(p=>`<div class="pl-card"><h4>📂 ${esc(p.name)}</h4><div class="lib-sub">${(p.tracks||[]).length} pistas</div></div>`).join('') + '</div>'
}
async function loadTop(){
  const el = document.getElementById('pane-top')
  const [tr, us] = await Promise.all([ api(`/api/top/tracks?guildId=${GID}&limit=10`), api(`/api/top/users?guildId=${GID}&limit=5`) ])
  let html = '<h3 style="margin:6px 0 10px"><i class="fas fa-music" style="color:#1DB954"></i> Canciones más reproducidas</h3>'
  html += (tr.j.data?.length ? tr.j.data.map((t,i)=>rowHtml({...t, artworkUrl:t.artwork},i,{count:t.playCount})).join('') : empty('fa-music','Aún no hay datos. ¡Reproduce música!'))
  html += '<h3 style="margin:22px 0 10px"><i class="fas fa-headphones" style="color:#5865F2"></i> Oyentes más activos</h3>'
  html += (us.j.data?.length ? us.j.data.map((u,i)=>`<div class="lib-row"><div class="lib-num">${i+1}</div><div class="lib-meta"><div class="lib-title">🎧 Usuario ${esc(String(u.userId).slice(-4))}</div><div class="lib-sub">${u.playCount} reproducciones</div></div></div>`).join('') : empty('fa-headphones','Sin datos de oyentes.'))
  el.innerHTML = html
}

document.querySelectorAll('.lib-tab').forEach(tab => tab.addEventListener('click', () => {
  document.querySelectorAll('.lib-tab').forEach(t=>t.classList.remove('active'))
  document.querySelectorAll('.lib-pane').forEach(p=>p.classList.remove('active'))
  tab.classList.add('active')
  document.getElementById('pane-'+tab.dataset.pane).classList.add('active')
}))

loadFav(); loadPl(); loadRec(); loadTop()
</script>

<%- include('../includes/footer') %>
